# Autoforge AI — Environment Configuration
# Add your API keys below. Autoforge AI automatically routes and falls back
# to whichever provider is configured.

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
NVIDIA_API_KEY=

# Optional: Web Search Tool (Tavily)
TAVILY_API_KEY=

# Optional Model Overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
CLAUDE_MODEL=claude-sonnet-4-5
