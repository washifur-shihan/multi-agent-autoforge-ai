# Autoforge AI — Environment Configuration
# Every provider is optional! You only need ONE key configured.
# If a model is unavailable or does not reply, Autoforge AI automatically
# falls back to the next configured provider.

MISTRAL_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
NVIDIA_API_KEY=

# Optional: Web Search Tool (Tavily)
TAVILY_API_KEY=

# Optional Model Overrides
# For Mistral Vibe / Coding: mistral-large-latest, devstral-small-latest, or codestral-latest
MISTRAL_MODEL=mistral-large-latest
# For Grok (xAI): grok-2-latest or grok-3-latest (or llama-3.3-70b-versatile if using a Groq gsk_ key)
GROK_MODEL=grok-2-latest
OPENAI_MODEL=gpt-4o-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
CLAUDE_MODEL=claude-sonnet-4-5
